# Copie para .env. Todos os valores abaixo são de exemplo, para uso local.
DATABASE_URL="postgresql://fluxo:fluxo_local@localhost:5436/fluxo?schema=public"

# Chave simples para o endpoint de recebimento (simula a credencial da caixa de e-mail)
INBOUND_API_KEY="chave-local-de-exemplo"

# Provedor de extracao: "rules" (padrao, deterministico) ou "rules+llm" (usa LLM so para texto livre duvidoso)
EXTRACTION_PROVIDER="rules"
# So e lida se EXTRACTION_PROVIDER=rules+llm. Deixe vazio para rodar sem LLM.
ANTHROPIC_API_KEY=""

# Canal de notificacao: "simulated" grava no banco (padrao) ou "webhook" envia POST para NOTIFY_WEBHOOK_URL
NOTIFIER="simulated"
NOTIFY_WEBHOOK_URL=""

# Alerta de excecoes paradas (v1.1): horas sem tratamento ate alertar
STALLED_EXCEPTION_HOURS="4"
