{
  "name": "fluxo-automacao-pedidos",
  "version": "1.0.0",
  "private": true,
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "description": "Fluxo: automação de pedidos por e-mail da Distribuidora Santa Clara (estudo de caso fictício)",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "orders:generate": "tsx scripts/generate-orders.ts",
    "load": "tsx tests/load/load.ts",
    "export:csv": "tsx scripts/export-csv.ts",
    "screenshots": "playwright test --config playwright.screens.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
